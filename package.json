{
  "name": "tcg-price-checker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "import:dm:sample": "node scripts/import-dm-cards-sample.mjs",
    "import:dm:full": "node scripts/import-dm-cards-full.mjs",
    "import:dm:aliases": "node scripts/fetch-dm-card-aliases.mjs",
    "build:dm:import": "node scripts/build-dm-card-import.mjs",
    "test:import:dm": "node --test --test-isolation=none scripts/import-dm-cards-sample.test.mjs scripts/import-dm-cards-full.test.mjs scripts/fetch-dm-card-aliases.test.mjs",
    "test:price-corrections": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test lib/price-correction-validation.test.mjs",
    "test:prices": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test lib/price-input-validation.test.mjs lib/price-correction-validation.test.mjs",
    "test": "npm run test:prices && npm run test:import:dm"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "cheerio": "1.0.0",
    "kuromoji": "0.1.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
